# Copy to .env and fill in real values. Never commit .env.
# Placeholders only in this file: no real hosts, passwords or tokens.

# --- Server ---
PORT=8000
# development | production
ENVIRONMENT=development
# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
# Shared secret the frontend sends as X-API-Key (generate a long random string)
API_SHARED_SECRET=change-me

# --- Database ---
# Local: the Docker container from SETUP.md
# Render: use the full internal connection string in production, or the external
# one with ?sslmode=require when connecting from a laptop.
DATABASE_URL=postgresql://user:password@localhost:5432/mvp_db
# Optional, laptop only: Render's external URL, used to run migrations against production
RENDER_DATABASE_URL=postgresql://user:password@host.singapore-postgres.render.com/dbname?sslmode=require

# --- Shopify (Dev Dashboard app installed on the store) ---
# Domain only: no https:// and no trailing slash
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Dev Dashboard → your app → Settings: Client ID and Client secret (starts with shpss_).
# The backend exchanges these for a 24-hour access token and renews it automatically.
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-10
# Leave empty: only for legacy custom apps created in the Shopify admin (fixed shpat_ token).
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
# Leave empty to verify webhooks with SHOPIFY_API_SECRET (how Dev Dashboard apps sign them).
SHOPIFY_WEBHOOK_SECRET=

# --- Seller details printed on invoices and labels ---
SELLER_NAME=Your Business Name
SELLER_GSTIN=22AAAAA0000A1Z5
SELLER_ADDRESS=Street, City, State, PIN
SELLER_PHONE=+91-0000000000
SELLER_EMAIL=orders@example.com

# --- Email ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# --- Error monitoring (leave empty to disable locally) ---
SENTRY_DSN=
