# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (Render managed PostgreSQL in production) ---
DATABASE_URL=postgres://user:password@localhost:5432/ecomsellercentral

# --- Shopify (custom app on the development store) ---
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# --- Email ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# --- Error monitoring ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
